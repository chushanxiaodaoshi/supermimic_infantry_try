#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "tn__Fudan2026Balance_vNA"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "tn__Fudan2026Balance_vNA" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "Left_rear_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Left_rear_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "Left_rear_child1_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Left_rear_child1_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "Left_Wheel_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Left_Wheel_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "Right_rear_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Right_rear_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "Right_rear_child1_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Right_rear_child1_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "Right_Wheel_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Right_Wheel_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "Left_front_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Left_front_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "Left_front_child1_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Left_front_child1_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "Left_front_child2_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Left_front_child2_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "Left_front_child3_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Left_front_child3_joint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "Right_front_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "Right_front_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }

                over "Right_front_child1_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "Right_front_child1_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }

                    over "Right_front_child2_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "Right_front_child2_joint" (
                            prepend apiSchemas = ["IsaacJointAPI"]
                        )
                        {
                        }

                        over "Right_front_child3_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Right_front_joint3_joint" (
                                prepend apiSchemas = ["IsaacJointAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }
}

